\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces  Demonstration of Vision Banana's metric depth estimation capabilities. The two columns to the left are the input images and the depth visualization image generated by Vision Banana. The depth images are then decoded back to metric depth values. Combining them with the camera intrinsics, we can reconstruct the 3D scene accurately. The two columns on the right are random views of the reconstructed scenes. Note that camera intrinsics are not needed in predicting the depth itself. Samples taken from NYU v2 \citep  {nyuv2} and ETH 3D \citep  {eth3d}. }}{11}{figure.caption.9}\protected@file@percent }
\newlabel{fig:depth-demo1}{{6}{11}{Demonstration of Vision Banana's metric depth estimation capabilities. The two columns to the left are the input images and the depth visualization image generated by Vision Banana. The depth images are then decoded back to metric depth values. Combining them with the camera intrinsics, we can reconstruct the 3D scene accurately. The two columns on the right are random views of the reconstructed scenes. Note that camera intrinsics are not needed in predicting the depth itself. Samples taken from NYU v2 \citep {nyuv2} and ETH 3D \citep {eth3d}}{figure.caption.9}{}}
\newlabel{fig:depth-demo1@cref}{{[figure][6][]6}{[1][10][]11}{}{}{}}
