\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Our Differentiable Renderer.} We estimate geometry, albedo, lighting, and normal maps from the triplane and metallic/roughness values from the image. We rasterize and interpolate these values as input to our shader (omitted here for simplicity). Our shader uses the Disney BRDF~\cite  {Burley2012} and performs Monte Carlo integration. We further perform visibility testing to improve shadow modeling. Finally, we compare the rendered image with the GT image and minimize the rendering loss.}}{5}{figure.caption.11}\protected@file@percent }
\@writefile{brf}{\backcite{Burley2012}{{5}{3}{figure.caption.11}}}
\newlabel{fig:rendering}{{3}{5}{\textbf {Our Differentiable Renderer.} We estimate geometry, albedo, lighting, and normal maps from the triplane and metallic/roughness values from the image. We rasterize and interpolate these values as input to our shader (omitted here for simplicity). Our shader uses the Disney BRDF~\cite {Burley2012} and performs Monte Carlo integration. We further perform visibility testing to improve shadow modeling. Finally, we compare the rendered image with the GT image and minimize the rendering loss}{figure.caption.11}{}}
\newlabel{fig:rendering@cref}{{[figure][3][]3}{[1][4][]5}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Shadow Modeling.} We perform visibility testing in screen-space by marching along sampled rays. If any point along the ray has a ray depth which is farther away than the depth map, we consider the entire ray as shadowed.}}{5}{figure.caption.11}\protected@file@percent }
\newlabel{fig:shadow_test}{{4}{5}{\textbf {Shadow Modeling.} We perform visibility testing in screen-space by marching along sampled rays. If any point along the ray has a ray depth which is farther away than the depth map, we consider the entire ray as shadowed}{figure.caption.11}{}}
\newlabel{fig:shadow_test@cref}{{[figure][4][]4}{[1][4][]5}{}{}{}}
