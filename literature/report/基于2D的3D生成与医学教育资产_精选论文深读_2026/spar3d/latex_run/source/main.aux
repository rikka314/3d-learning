\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {SPAR3D\xspace  Overview.} Conditioned on the input image, SPAR3D\xspace  first leverages a point diffusion model to generate a sparse point cloud. The triplane transformer then uses the sampled point cloud and image features to produce high-resolution triplane features. The triplane features are then queried to reconstruct the geometry, texture, and illumination of the object in the image.}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:overview}{{2}{3}{\textbf {\method Overview.} Conditioned on the input image, \method first leverages a point diffusion model to generate a sparse point cloud. The triplane transformer then uses the sampled point cloud and image features to produce high-resolution triplane features. The triplane features are then queried to reconstruct the geometry, texture, and illumination of the object in the image}{figure.caption.3}{}}
\newlabel{fig:overview@cref}{{[figure][2][]2}{[1][2][]3}{}{}{}}
