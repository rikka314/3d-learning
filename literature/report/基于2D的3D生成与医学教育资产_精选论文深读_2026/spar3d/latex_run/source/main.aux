\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Decomposition and Relighting Results.} We show decomposed albedo and relighting results of SPAR3D\xspace  in comparison with SF3D. The albedo estimated by SPAR3D\xspace  has less baked-in lighting compared with SF3D and results in better relighting outcomes.}}{1}{figure.caption.34}\protected@file@percent }
\newlabel{fig:supp-decomp}{{9}{1}{\textbf {Decomposition and Relighting Results.} We show decomposed albedo and relighting results of \method in comparison with SF3D. The albedo estimated by \method has less baked-in lighting compared with SF3D and results in better relighting outcomes}{figure.caption.34}{}}
