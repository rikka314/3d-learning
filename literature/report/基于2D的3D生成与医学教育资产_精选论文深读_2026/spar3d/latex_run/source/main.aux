\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Qualitative Comparison.} We compare SPAR3D\xspace  to other state-of-the-art methods visually. SPAR3D\xspace  not only aligns better with the visible surfaces from images, but also generates higher-quality geometries and textures for the occluded surfaces.}}{7}{figure.caption.24}\protected@file@percent }
\newlabel{fig:qualitative}{{5}{7}{\textbf {Qualitative Comparison.} We compare \method to other state-of-the-art methods visually. \method not only aligns better with the visible surfaces from images, but also generates higher-quality geometries and textures for the occluded surfaces}{figure.caption.24}{}}
